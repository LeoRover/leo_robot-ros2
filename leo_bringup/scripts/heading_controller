#!/usr/bin/env python3

import math

import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data

from geometry_msgs.msg import Twist
from sensor_msgs.msg import Imu
from tf_transformations import euler_from_quaternion


class HeadingController(Node):
    def __init__(self) -> None:
        super().__init__("heading_controller")

        self.declare_parameter("linear_hold_deadband", 0.05)
        self.declare_parameter("kp", 15.0)
        self.declare_parameter("max_correction", 1.0)
        self.declare_parameter("yaw_deadband", 0.005)
        self.declare_parameter("angular_hold_deadband", 0.2)

        self.linear_hold_deadband = (
            self.get_parameter("linear_hold_deadband").get_parameter_value().double_value
        )
        self.kp = self.get_parameter("kp").get_parameter_value().double_value
        self.max_correction = (
            self.get_parameter("max_correction").get_parameter_value().double_value
        )
        self.yaw_deadband = (
            self.get_parameter("yaw_deadband").get_parameter_value().double_value
        )
        self.angular_hold_deadband = (
            self.get_parameter("angular_hold_deadband")
            .get_parameter_value()
            .double_value
        )

        self.current_yaw: float | None = None
        self.heading_ref: float | None = None
        self.last_cmd_time: rclpy.time.Time | None = None

        self.imu_sub = self.create_subscription(
            Imu,
            "imu/data",
            self.imu_callback,
            qos_profile_sensor_data,
        )
        self.cmd_sub = self.create_subscription(
            Twist,
            "~/cmd_vel",
            self.cmd_callback,
            1,
        )
        self.cmd_pub = self.create_publisher(Twist, "cmd_vel", 1)

    def imu_callback(self, msg: Imu) -> None:
        q = msg.orientation
        _, _, self.current_yaw = euler_from_quaternion((q.x, q.y, q.z, q.w))

    def cmd_callback(self, msg: Twist) -> None:
        now = self.get_clock().now()
        if self.last_cmd_time is None:
            dt = 0.0
        else:
            # Time delta in seconds
            dt = (now - self.last_cmd_time).nanoseconds * 1e-9
        self.last_cmd_time = now

        if self.current_yaw is None:
            self.cmd_pub.publish(msg)
            return

        heading_hold_request = (
            abs(msg.angular.z) <= self.angular_hold_deadband
            and abs(msg.linear.x) >= self.linear_hold_deadband
        )

        if heading_hold_request:
            if self.heading_ref is None:
                self.heading_ref = self.current_yaw

            # Normalized heading error to [-pi, pi]
            heading_error = math.atan2(
                math.sin(self.current_yaw - self.heading_ref),
                math.cos(self.current_yaw - self.heading_ref),
            )
            if abs(heading_error) < self.yaw_deadband:
                correction = 0.0
            else:
                correction = max(
                    -self.max_correction,
                    min(-self.kp * heading_error, self.max_correction),
                )

            filtered = Twist()
            filtered.linear.x = msg.linear.x
            filtered.linear.y = msg.linear.y
            filtered.linear.z = msg.linear.z
            filtered.angular.x = msg.angular.x
            filtered.angular.y = msg.angular.y
            filtered.angular.z = msg.angular.z + correction
            self.cmd_pub.publish(filtered)

            # Update heading reference for next iteration to prevent drift when turning
            self.heading_ref += msg.angular.z * dt
            return

        self.heading_ref = None
        self.cmd_pub.publish(msg)


if __name__ == "__main__":
    rclpy.init()
    node = HeadingController()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()
